{
  "name": "skilltwin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "build:core": "tsc -p tsconfig.core.json",
    "test:core": "npm run build:core && node --test tests/core.test.mjs",
    "demo": "npm run build:core && node dist/scripts/demo.js",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "lint": "eslint .",
    "qa:migrations": "node scripts/verify-migrations.mjs",
    "qa:client-boundary": "node scripts/check-client-boundaries.mjs",
    "qa:static": "npm run qa:migrations && npm run qa:client-boundary",
    "qa:db": "node scripts/verify-release-db.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "release:verify": "npm run lint && npm run qa:static && npm run typecheck:core && npm run test:core && npm run typecheck && npm run build",
    "qa:rls": "node scripts/test-rls.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.56.0",
    "@tanstack/react-query": "^5.85.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reactflow": "^11.11.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.47",
    "supabase": "^2.30.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": "22.x"
  }
}
