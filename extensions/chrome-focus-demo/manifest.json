{
  "manifest_version": 3,
  "name": "SkillTwin Focus - Demo",
  "description": "Opt-in website focus timer; learn to unlock. Local demo, not device-wide protection.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*",
    "*://*.youtu.be/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SkillTwin Focus",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "core.mjs",
        "styles.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
